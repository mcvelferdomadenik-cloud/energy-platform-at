#!/bin/sh
# Refuse the commit if it carries a secret, fails lint, or fails tests.
# Enabled per clone with:  git config core.hooksPath .githooks

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
    exit 0
fi

if printf '%s\n' "$staged" | grep -qE '(^|/)\.env$'; then
    echo "pre-commit: refusing to commit a .env file" >&2
    exit 1
fi

# Fails closed: without the scanner there is no secret check, so there is no commit.
if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed, so staged changes cannot be checked for secrets" >&2
    echo "            winget install --id Gitleaks.Gitleaks --version 8.30.1 --exact" >&2
    exit 1
fi

echo "pre-commit: gitleaks"
if ! gitleaks git --pre-commit --staged --redact --verbose --no-banner \
        --config .gitleaks.toml --gitleaks-ignore-path .gitleaksignore; then
    echo "pre-commit: a staged change looks like a secret; the finding above names the file and line" >&2
    echo "            if it is truly not a secret, add its fingerprint to .gitleaksignore with a reason" >&2
    exit 1
fi

echo "pre-commit: ruff"
uv run ruff check .

echo "pre-commit: pytest"
uv run pytest -q
