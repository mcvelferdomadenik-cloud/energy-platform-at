#!/bin/sh
# Refuse the commit if it carries a secret, fails lint, or fails tests.
# Enabled per clone with:  git config core.hooksPath .githooks

set -e

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then
    exit 0
fi

if printf '%s\n' "$staged" | grep -qE '(^|/)\.env$'; then
    echo "pre-commit: refusing to commit a .env file (THREAT_MODEL.md T1)" >&2
    exit 1
fi

if git diff --cached -U0 -- $staged | grep -qE '^\+.*(ENTSOE_API_TOKEN|SECURITY_TOKEN|securityToken)[=:[:space:]]+["'"'"']?[A-Za-z0-9._-]{16,}'; then
    echo "pre-commit: a staged line looks like it contains a real token (THREAT_MODEL.md T4)" >&2
    echo "            check it, and if it is a placeholder make it shorter than 16 characters" >&2
    exit 1
fi

echo "pre-commit: ruff"
uv run ruff check .

echo "pre-commit: pytest"
uv run pytest -q
