# Copy to .env and fill in. Never commit .env.

ENTSOE_API_TOKEN=

POSTGRES_DB=megavolt
POSTGRES_USER=megavolt
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# How code outside Docker reaches the warehouse. Inside Docker, Compose sets its own.
WAREHOUSE_WRITER_PASSWORD=
WAREHOUSE_DSN=postgresql://megavolt_writer:CHANGEME@127.0.0.1:5433/megavolt

# 50000 on Windows and macOS; on Linux use the output of: id -u
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=
# 32 random bytes, base64: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# Every simulated member, reading and defect derives from this. Change it and you get a
# different community; keep it and a replay reproduces the same bytes.
SIMULATOR_SEED=megavolt
