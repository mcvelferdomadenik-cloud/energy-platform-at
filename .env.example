# Copy to .env and fill in. Never commit .env.

ENTSOE_API_TOKEN=

POSTGRES_DB=megavolt
POSTGRES_USER=megavolt
POSTGRES_PASSWORD=
POSTGRES_PORT=5433

# How code outside Docker reaches the warehouse. Inside Docker, Compose sets its own.
WAREHOUSE_WRITER_PASSWORD=
WAREHOUSE_DSN=postgresql://megavolt_writer:CHANGEME@127.0.0.1:5433/megavolt

# dbt reads raw and builds staging and marts as its own role (dbt/profiles.yml).
WAREHOUSE_DBT_PASSWORD=

# The internal pricing tool reads staging and marts as its own role, and can write nothing.
WAREHOUSE_READER_PASSWORD=
# Postgres memory, optional: without these the warehouse starts with laptop-sized defaults
# (1GB / 4GB / 32MB / 256MB / 2). A 64 GB server whose main tenant is the warehouse:
# WAREHOUSE_SHARED_BUFFERS=8GB
# WAREHOUSE_EFFECTIVE_CACHE_SIZE=24GB
# WAREHOUSE_WORK_MEM=128MB
# WAREHOUSE_MAINTENANCE_WORK_MEM=2GB
# WAREHOUSE_PARALLEL_WORKERS=4
# The tool itself gets ONLY this line, in a gitignored .env.tool, never the whole .env.
TOOL_DSN=postgresql://megavolt_reader:CHANGEME@127.0.0.1:5433/megavolt
# Supabase: users, roles and the audit record. The tool holds the PUBLIC anon key only, never
# service_role. SUPABASE_JWT_SECRET only for a project still on the legacy HS256 secret; new
# projects publish their signing keys and the line stays empty.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# 50000 on Windows and macOS; on Linux use the output of: id -u
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=
# 32 random bytes, base64: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

# Every simulated member, reading and defect derives from this. Change it and you get a
# different community; keep it and a replay reproduces the same bytes.
SIMULATOR_SEED=megavolt

# From the laptop. Inside Docker, Compose sets redpanda:9092 instead.
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
