# Copy this file to .env and fill in the values.
# .env is gitignored and must never be committed. See THREAT_MODEL.md T1-T5.

# ENTSO-E Transparency Platform API token.
# Register at https://transparency.entsoe.eu/ and request the token by email.
ENTSOE_API_TOKEN=

# Local warehouse (Docker Compose). Generate your own password, never reuse one.
POSTGRES_DB=megavolt
POSTGRES_USER=megavolt
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
